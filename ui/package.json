{
  "name": "cassie-ui",
  "type": "module",
  "scripts": {
    "clean": "npx rimraf node_modules dist",
    "dev": "vp dev",
    "dev:mock": "VITE_MOCK_API=true vp dev",
    "build": "vp build",
    "preview": "vp preview",
    "test": "npm run test:unit && npm run test:e2e:mock",
    "test:unit": "vp test",
    "test:e2e": "playwright test",
    "test:e2e:mock": "playwright test --config playwright.mock.config.ts",
    "install:browsers": "playwright install chromium",
    "gen": "npm run gen:adapters && npm run fmt",
    "gen:adapters": "askr generate ../public/openapi.yml --output ./src/adapters/generated",
    "gen:adapters:check": "askr generate ../public/openapi.yml --output ./src/adapters/generated --check",
    "type-check": "tsc --noEmit",
    "fmt:check": "vp fmt . --check",
    "audit:production": "npm audit --omit=dev --audit-level=moderate",
    "lint": "vp lint",
    "lint:fix": "vp lint src tests dev --fix",
    "fmt": "vp fmt"
  },
  "dependencies": {
    "@askrjs/askr": "0.5.0",
    "@askrjs/auth": "0.5.0",
    "@askrjs/fetch": "0.5.0",
    "@askrjs/lucide": "0.5.0",
    "@askrjs/monaco": "0.5.0",
    "@askrjs/themes": "0.5.0",
    "@askrjs/ui": "0.5.0",
    "@askrjs/vite": "0.5.0"
  },
  "devDependencies": {
    "@askrjs/cli": "0.5.0",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@types/node": "^26.6.5",
    "autoprefixer": "^10.6.1",
    "jsdom": "^30.1.2",
    "postcss": "^8.5.29",
    "typescript": "^7.0.2",
    "vite-plus": "^1.3.0"
  },
  "overrides": {
    "monaco-editor": {
      "dompurify": "3.4.17"
    }
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "npm@12.0.1",
  "allowScripts": {
    "fsevents@2.3.3": true,
    "fsevents@2.3.2": true,
    "esbuild@0.28.2": true
  }
}
