  "queries": {
    "builtin_composite_fields": "SELECT t.oid::int8 AS type_oid,t.typrelid::int8 AS relation_oid,a.attnum::int4 AS field_number,a.attname,a.atttypid::int8 AS type_id,a.atttypmod,a.attnotnull,a.attisdropped,a.attcollation::int8 AS collation_id FROM pg_type t JOIN pg_attribute a ON a.attrelid=t.typrelid WHERE t.oid IN (71,75,81,83) AND a.attnum>0 ORDER BY t.oid,a.attnum",
