{
  "name": "cassie-ui",
  "type": "module",
  "scripts": {
    "clean": "npx rimraf node_modules dist",
    "dev": "vp dev",
    "dev:mock": "VITE_MOCK_API=true vp dev",
    "build": "vp build",
    "preview": "vp preview",
    "test": "vp test",
    "test:e2e": "playwright test",
    "test:e2e:mock": "playwright test --config playwright.mock.config.ts",
    "gen": "npm run gen:adapters && npm run fmt",
    "gen:adapters": "askr generate ../public/openapi.yml --output ./src/adapters/generated",
    "gen:adapters:check": "askr generate ../public/openapi.yml --output ./src/adapters/generated --check",
    "type-check": "tsc --noEmit",
    "fmt:check": "vp fmt . --check --ignore-path .oxfmtignore",
    "audit:production": "npm audit --omit=dev --audit-level=moderate",
    "lint": "vp lint src tests dev vite.config.ts",
    "lint:fix": "vp lint src tests dev --fix",
    "fmt": "vp fmt . --ignore-path .oxfmtignore"
  },
  "dependencies": {
    "@askrjs/askr": "0.0.85",
    "@askrjs/auth": "0.0.7",
    "@askrjs/fetch": "0.0.2",
    "@askrjs/lucide": "0.0.6",
    "@askrjs/monaco": "0.0.6",
    "@askrjs/themes": "0.0.19",
    "@askrjs/ui": "0.0.23",
    "@askrjs/vite": "0.0.11",
    "monaco-editor": "0.56.0"
  },
  "devDependencies": {
    "@askrjs/cli": "0.0.18",
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.62.1",
    "@types/node": "^26.1.2",
    "autoprefixer": "^10.5.4",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.25",
    "typescript": "^7.0.2",
    "vite": "8.2.0",
    "vite-plus": "^0.2.7"
  },
  "overrides": {
    "dompurify": "3.4.12"
  },
  "engines": {
    "node": "24.x",
    "npm": "11.16.0"
  },
  "packageManager": "npm@11.16.0",
  "allowScripts": {
    "fsevents@2.3.3": true,
    "fsevents@2.3.2": true,
    "esbuild@0.28.1": true
  }
}
